# Copie este arquivo para ".env" (mesma pasta) e preencha.
# O .env fica fora do git; nunca coloque a chave em arquivos versionados.

# Chave da API do Racing League Tools (header X-API-Key)
RLT_API_KEY=

# OBS: Ferramentas > WebSocket Server Settings
#OBS_WS_URL=ws://127.0.0.1:4455
#OBS_WS_PASSWORD=

# Portas (padrao: 8080 para HTTP/WebSocket, 5607 para o listener.ps1)
#HTTP_PORT=8080
#BRIDGE_PORT=5607

# Por padrao so este computador acessa o servidor. Use 1 para liberar o
# painel e a overlay para outros aparelhos da rede local.
#ALLOW_LAN=1

# Imagens (logos, icones): a overlay busca primeiro na fonte online e usa a
# pasta local overlay/assets como reserva. O padrao online e o repositorio
# liga_lets_go_imageAssets. Deixe ASSETS_BASE_URL= (vazio) para usar so a
# pasta local, ou aponte para outro repositorio/URL.
#ASSETS_BASE_URL=https://github.com/Acceler23/liga_lets_go_imageAssets
# Outra pasta local no lugar de overlay/assets
#ASSETS_PATH=
